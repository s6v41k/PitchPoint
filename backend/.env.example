# Server
PORT=4000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pitchpoint
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: automation webhook (Zapier/n8n/Make). If set, a POST request
# fires whenever a booking is created. Leave empty to disable — the app
# works fully without it. See README "Automation" section for setup.
AUTOMATION_WEBHOOK_URL=

# Optional: Gmail account used to send "forgot password" reset emails.
# EMAIL_USER is the Gmail address; EMAIL_PASS is a 16-character Gmail App
# Password (not your normal password) — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on the account first). Leave both empty to disable actual
# sending — the reset link is still logged to the backend console, so the
# flow works for local testing either way.
EMAIL_USER=
EMAIL_PASS=
